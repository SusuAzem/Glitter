<div class="modal" id="ContactModal" tabindex="-1" role="dialog" aria-labelledby="ContactModal" aria-hidden="true">
    <div class="modal-dialog" style="background: rgba(9, 30, 62, .7);">
        <div class="modal-content">
            <div class="modal-header border-1">
                <h5 class="modal-title" id="ModalTitle">Contact Us</h5>
            </div>
            <div class="modal-body">
                <div class="row mb-5">
                    <div class="col-lg-4">
                        <div class="d-flex align-items-center">
                            <div class="ic bg-primary d-flex align-items-center justify-content-center rounded">
                                <i class="fa fa-phone-alt text-white"></i>
                            </div>
                            <div class="ps-1">
                                <h6 class="tel text-primary mb-0">0500559655</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="d-flex align-items-center">
                            <div class="ic bg-primary d-flex align-items-center justify-content-center rounded">
                                <i class="fa fa-envelope-open text-white"></i>
                            </div>
                            <div class="ps-0">
                                <h6 class="email text-primary mb-0">REEM@THEGLITTER.NET</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="d-flex align-items-center">
                            <div class="ic bg-primary d-flex align-items-center justify-content-center rounded">
                                <i class="fa fa-map-marker-alt text-white"></i>
                            </div>
                            <div class="ps-1">
                                @*                                 <h6 class="text-primary mb-0">*@
                                <address class="text-primary mb-0">
                                    Riyadh, AlOlaya
                                </address>
                                @*                                 </h6>*@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-5">
                    <div class="col-lg-6mx-auto">
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" class="form-control border-1 bg-light px-4" placeholder="Your Name" style="height: 55px;">
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="form-control border-1 bg-light px-4" placeholder="Your Email" style="height: 55px;">
                                </div>
                                <div class="col-12">
                                    <input type="text" class="form-control border-1 bg-light px-4" placeholder="Subject" style="height: 55px;">
                                </div>
                                <div class="col-12">
                                    <textarea class="form-control border-1 bg-light px-4 py-3" rows="4" placeholder="Message"></textarea>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-primary w-100 py-3" type="submit">Send Message</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                @*  <div>
                    <iframe class="position-relative rounded w-100 h-100"
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3001156.4288297426!2d-78.01371936852176!3d42.72876761954724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ccc4bf0f123a5a9%3A0xddcfc6c1de189567!2sNew%20York%2C%20USA!5e0!3m2!1sen!2sbd!4v1603794290143!5m2!1sen!2sbd"
                            frameborder="0" style="min-height: 350px; border:0;" allowfullscreen="" aria-hidden="false"
                            tabindex="0"></iframe>
                </div> *@
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
