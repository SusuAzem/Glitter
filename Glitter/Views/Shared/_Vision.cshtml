@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<span class="anchor" id="visionAn"></span>
<div id="vision" class="container center py-4 wow fadeInUp" data-wow-delay="2s" data-wow-duration="2s">
    <div class="py-1 w-100 px-1 mx-auto">
        <div class="card mx-auto">
            <div class="flip-card">
                <div class="flip-card-container">
                    <div class="card-front">
                        <div class="card-front-top">
                            <img class="card-front-icon" src="~/img/visionIcon.png" />
                            <h2 class="card-front-heading">
                                @Configuration["Vision:Title"]
                            </h2>
                        </div>
                    </div>
                    <div class="card-back">
                        <img src="..\img\vision back.png" />
                        <h3 class="inside-page-heading">
                            @Configuration["Vision:Title2"]
                        </h3>
                    </div>
                </div>
            </div>
            <div class="inside-page">
                <div class="inside-page-container">                    
                    <p class="inside-page-text IndJus .mb-0">
                        @Configuration["Vision:Text"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
